# define your env variables for the test env here
KERNEL_CLASS='App\Kernel'
APP_SECRET='$ecretf0rt3st'
# ! .env.local n'est jamais chargé quand APP_ENV=test (règle Symfony : les tests doivent donner le même
# ! résultat partout, y compris en CI où .env.local n'existe pas) -- JWT_PASSPHRASE doit donc être définie
# ! ici pour que la suite de tests puisse générer des JWT. Sans risque réel : config/jwt/*.pem n'est pas
# ! commité (gitignoré), une passphrase seule sans la clé privée qui va avec ne donne accès à rien.
JWT_PASSPHRASE=a63fd320ad6eb16da837f7ec2881d20c06b1e8bb8b745c8dfa52de65738b2034
# * Secret HMAC arbitraire utilisé uniquement pour signer/vérifier les faux webhooks dans les tests
# * (StripeWebhookControllerTest) -- ce n'est pas une vraie clé Stripe, rien à protéger ici.
STRIPE_WEBHOOK_SECRET=whsec_test_fixed_secret
