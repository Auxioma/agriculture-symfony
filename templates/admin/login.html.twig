<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="robots" content="noindex, nofollow">
    <title>Connexion — Back-office TrouveMoi Agri</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="{{ asset('styles/admin.css') }}">
</head>
<body class="tm-login-page">
    <main class="tm-login">
        <div class="tm-login-card">
            <div class="tm-logo tm-login-logo">
                <img class="tm-logo-img" src="/img/logo.png" alt="TrouveMoi Agri" onerror="this.parentNode.classList.add('no-logo');this.remove()">
                <span class="tm-logo-text">TrouveMoi Admin</span>
            </div>
            <h1 class="tm-login-title">Connexion</h1>
            <p class="tm-subtitle">Accédez au back-office de la plateforme</p>

            {% if error %}
                <div class="alert alert-danger" role="alert">{{ error.messageKey|trans(error.messageData, 'security') }}</div>
            {% endif %}

            <form method="post">
                <div class="tm-field">
                    <label for="username">Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" required autofocus autocomplete="username">
                </div>
                <div class="tm-field">
                    <label for="password">Mot de passe</label>
                    <input type="password" name="_password" id="password" required autocomplete="current-password">
                </div>
                {# Formulaire de saisie de l'email et page de réinitialisation : côté front Angular (voir
                   SecurityController::login() et AuthController::forgotPassword()), pas dans ce back-office
                   Twig -- ce lien n'est qu'un point d'entrée vers ce parcours. #}
                <a href="{{ forgot_password_url }}" class="tm-login-forgot">Mot de passe oublié ?</a>
                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">
                <button class="tm-btn tm-btn-primary tm-btn-block" type="submit">Se connecter</button>
            </form>
        </div>
    </main>
</body>
</html>
